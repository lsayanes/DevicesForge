// ============================================================================
// VintageMixerChannel - Windows Resource File
// ============================================================================

#include <windows.h>

// Version Information
#define VI_MAJOR       1
#define VI_MINOR       0
#define VI_PATCH       0
#define VI_BUILD       0

#define VI_STRING      "1, 0, 0, 0"
#define VI_STRING_STR  "1.0.0.0"

// ============================================================================
// Version Info Structure
// ============================================================================
VS_VERSION_INFO VERSIONINFO
FILEVERSION     VI_MAJOR,VI_MINOR,VI_PATCH,VI_BUILD
PRODUCTVERSION  VI_MAJOR,VI_MINOR,VI_PATCH,VI_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS       VS_FF_DEBUG
#else
FILEFLAGS       0x0L
#endif
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DRV
FILESUBTYPE     VFT2_DRV_AUDIO
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "VintageMixer"
            VALUE "FileDescription",  "Vintage Mixer Channel Plugin"
            VALUE "FileVersion",      VI_STRING_STR
            VALUE "InternalName",     "VintageMixerChannel"
            VALUE "LegalCopyright",   "Copyright (C) 2026 VintageMixer"
            VALUE "OriginalFilename", "VintageMixerChannel.vst3"
            VALUE "ProductName",      "Vintage Mixer Channel"
            VALUE "ProductVersion",   VI_STRING_STR
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

// ============================================================================
// Icon (optional - add your icon file)
// ============================================================================
// IDI_ICON1 ICON "icon.ico"
